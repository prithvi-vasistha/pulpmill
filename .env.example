# pulpmill environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
#
# ONLY secrets belong here. All non-secret tuning lives in config/pipeline.yaml.
# Every value below is optional: with an empty .env the pipeline still runs
# against every source that does not require authentication (currently 4chan).

# ---------------------------------------------------------------------------
# Reddit  (REQUIRED for the Reddit adapter -- see docs/CREDENTIALS.md)
# ---------------------------------------------------------------------------
# Reddit's anonymous JSON endpoints return HTTP 403 as of 2026; OAuth is the
# only supported read path. Create an app at:
#   https://www.reddit.com/prefs/apps  ->  "create another app..."
# Choose type "script". The client id is the string under the app name; the
# secret is the field labelled "secret".
PULPMILL_REDDIT_CLIENT_ID=
PULPMILL_REDDIT_CLIENT_SECRET=

# Auth mode: "client_credentials" (default, app-only, read-only, no account
# password needed) or "password" (script-app grant, needs the two fields below).
PULPMILL_REDDIT_AUTH_MODE=client_credentials
PULPMILL_REDDIT_USERNAME=
PULPMILL_REDDIT_PASSWORD=

# Reddit requires a unique descriptive User-Agent in the documented format:
#   <platform>:<app id>:<version> (by /u/<reddit username>)
# Requests with a generic agent are aggressively rate-limited.
PULPMILL_REDDIT_USER_AGENT=linux:pulpmill:0.1.0 (by /u/YOUR_REDDIT_USERNAME)

# ---------------------------------------------------------------------------
# X / Twitter  (OPTIONAL -- adapter is disabled by default)
# ---------------------------------------------------------------------------
# X retired its free read tier; reads are billed per request. The adapter is
# implemented but ships disabled. See docs/SOURCES.md for the full assessment
# before enabling it. OAuth 2.0 App-Only bearer token from
#   https://developer.x.com  ->  Project -> Keys and tokens
PULPMILL_X_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Claude editorial selection  (OPTIONAL)
# ---------------------------------------------------------------------------
# With no key the `select` command uses the deterministic ranking order. The
# pipeline never hard-depends on this.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Runtime overrides (OPTIONAL)
# ---------------------------------------------------------------------------
# Absolute path to an extra YAML config layered over config/pipeline.yaml.
# PULPMILL_CONFIG=/home/you/Projects/Content-Generation-Pipeline/config/pipeline.local.yaml

# Override the data directory (database + logs). Default: ./var
# PULPMILL_DATA_DIR=/home/you/Projects/Content-Generation-Pipeline/var

# Console log level: DEBUG | INFO | WARNING | ERROR
# PULPMILL_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Publishing  (all optional -- every target ships disabled)
# ---------------------------------------------------------------------------
# Each of these platforms has an approval step that cannot be automated. The
# adapters are fully implemented and tested; the gates are procedural. Read
# docs/PUBLISHING.md before starting, because the applications take weeks and
# are the critical path.
#
# `pulpmill publish` is a dry run unless given --live, and a dry run needs no
# credentials at all -- so the whole path is testable before any of this exists.

# YouTube Shorts. The binding constraint is quota, not credentials:
# videos.insert costs 1600 of a default 10,000 units/day, so ~6 uploads/day
# until Google approves an increase. Publish the OAuth consent screen, or
# refresh tokens expire every 7 days and the worker dies weekly.
PULPMILL_YOUTUBE_CLIENT_ID=
PULPMILL_YOUTUBE_CLIENT_SECRET=
PULPMILL_YOUTUBE_REFRESH_TOKEN=

# Instagram Reels. Needs a Business/Creator account and App Review for the
# instagram_content_publish permission. Meta fetches the file from a URL rather
# than accepting an upload, so publishing also needs HTTPS hosting -- set
# publishing.targets.instagram.options.public_base_url in config/pipeline.yaml.
PULPMILL_INSTAGRAM_ACCESS_TOKEN=
PULPMILL_INSTAGRAM_USER_ID=

# TikTok Content Posting API. Unaudited apps are restricted to SELF_ONLY
# visibility regardless of the privacy level requested.
PULPMILL_TIKTOK_ACCESS_TOKEN=
